# -------------------------------------------------------------
# HackNest Frontend - Environment Variables
# -------------------------------------------------------------
# Copy this file to .env.local or .env.production depending on 
# your target deployment environment.
# 
# DO NOT COMMIT actual .env files containing production secrets.
# -------------------------------------------------------------

# Backend API URL (Ensure no trailing slash)
# Local Development: http://localhost:8080
# Production: https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:8080

# Application Domain (For SEO and Metadata linking)
VITE_APP_URL=http://localhost:5173

# Features Toggles (Optional examples)
VITE_ENABLE_ANALYTICS=false
